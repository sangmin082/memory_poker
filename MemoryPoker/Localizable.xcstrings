        }
      }
    },
    "16장을 외운 뒤 2장을 골라 공유 카드 3장과 조합" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorize 16 cards, pick 2, combine with 3 shared cards"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16장을 외운 뒤 2장을 골라 공유 카드 3장과 조합"
